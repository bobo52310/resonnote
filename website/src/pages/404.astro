---
import Base from '../layouts/Base.astro';
import BrandMark from '../components/BrandMark.astro';
---

<Base title="找不到這一頁" description="這一格膠卷不見了。回到 ResonNote 共鳴筆記首頁。" path="/404" noindex>
  <main id="main" class="grid min-h-dvh place-items-center px-5 py-16">
    <div class="w-full max-w-lg text-center">
      <a href="/" class="inline-flex rounded-xl" aria-label="ResonNote 共鳴筆記首頁">
        <BrandMark size={56} />
      </a>
      <div class="lost mt-10" aria-hidden="true">
        <div class="sprockets"></div>
        <div class="lost-frame"><span class="mono">404</span></div>
        <div class="sprockets"></div>
      </div>
      <h1 class="mt-10 text-3xl font-black sm:text-4xl">這一格膠卷不見了。</h1>
      <p class="mt-4 text-ink-300">你要找的頁面不存在，可能是網址打錯，或是它已經被剪掉了。</p>
      <a href="/" class="btn btn-primary mt-9">
        <span class="rec-dot" aria-hidden="true"></span>
        回到首頁
      </a>
    </div>
  </main>
</Base>

<style>
  .lost {
    display: grid;
    gap: 0.6rem;
    padding: 0.6rem 0.75rem;
    border-radius: 0.75rem;
    background: linear-gradient(180deg, var(--color-film), #0f0d0a 50%, var(--color-film));
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.06);
  }
  .lost-frame {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    border-radius: 0.3rem;
    background:
      repeating-linear-gradient(0deg, rgb(255 255 255 / 0.025) 0 2px, transparent 2px 4px),
      #000;
  }
  .lost-frame span {
    color: var(--color-amber);
    font-size: clamp(3rem, 12vw, 5rem);
    font-weight: 800;
    letter-spacing: 0.08em;
  }
</style>
