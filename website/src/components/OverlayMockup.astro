---
/**
 * A drawing of the extension's note overlay (src/core/overlay/overlay.ts), over a paused,
 * dimmed frame. Stills are original generated images; the show title is made up.
 */
const img = (name: string) => `/images/still-${name}-640.webp`;
---

<div
  class="mock"
  role="img"
  aria-label="ResonNote 小視窗示意圖：上方膠卷小格是這部片前面記過的兩則筆記，下面帶入這一刻的截圖、片名、秒數 16:43、台詞「如果那天我有說出口就好了。」，以及正在輸入的心得。"
>
  <img class="mock-backdrop" src={img('rain')} width="640" height="360" alt="" loading="lazy" decoding="async" />
  <div class="mock-panel" aria-hidden="true">
    <div class="m-film">
      <div class="m-frames">
        <div class="m-frame age-2">
          <img src={img('lab')} width="640" height="360" alt="" loading="lazy" decoding="async" />
          <span class="m-code">12:05</span>
        </div>
        <span class="m-arrow">›</span>
        <div class="m-frame age-1">
          <img src={img('rooftop')} width="640" height="360" alt="" loading="lazy" decoding="async" />
          <span class="m-code">15:25</span>
        </div>
        <span class="m-arrow">›</span>
        <div class="m-frame now">
          <img src={img('rain')} width="640" height="360" alt="" loading="lazy" decoding="async" />
          <span class="m-code">16:43</span>
        </div>
      </div>
      <p class="m-caption"><b>15:25</b>轉折點，記下來寫文</p>
    </div>

    <div class="m-top">
      <img class="m-thumb" src={img('rain')} width="640" height="360" alt="" loading="lazy" decoding="async" />
      <div class="m-info">
        <p class="m-heading">雨停之前</p>
        <p class="m-time">16:43</p>
        <div class="m-field">如果那天我有說出口就好了。</div>
      </div>
    </div>
    <div class="m-field m-note">這句要寫進下一篇文章，後悔比錯過更痛<span class="m-caret"></span></div>
    <p class="m-hint">Enter 存檔並繼續播放　Shift+Enter 換行　Esc 或點外面取消</p>
    <p class="m-footer"><span>開啟筆記本</span></p>
  </div>
</div>

<style>
  .mock {
    position: relative;
    container-type: inline-size;
    overflow: hidden;
    padding: clamp(1rem, 5cqw, 2.5rem) clamp(0.75rem, 4cqw, 2.5rem);
    border-radius: 1.25rem;
    background: #000;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.06),
      0 30px 80px -30px rgb(0 0 0 / 0.9);
  }
  .mock-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(10px) brightness(0.35);
    transform: scale(1.08);
  }
  .mock-panel {
    position: relative;
    padding: 16px;
    border-radius: 12px;
    background: rgb(20 20 20 / 0.92);
    box-shadow: 0 8px 32px rgb(0 0 0 / 0.6);
    font-size: 14px;
    line-height: 1.5;
    color: #f5f5f5;
  }

  /* Film strip of earlier notes, oldest left. */
  .m-film {
    position: relative;
    margin: -4px -4px 14px;
    padding: 16px 14px;
    border-radius: 4px;
    background: linear-gradient(180deg, #1c1813, #0f0d0a 50%, #1c1813);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.06),
      0 4px 14px rgb(0 0 0 / 0.5);
    transform: rotate(-0.6deg);
  }
  .m-film::before,
  .m-film::after {
    content: '';
    position: absolute;
    left: 6px;
    right: 6px;
    height: 6px;
    background: repeating-linear-gradient(90deg, rgb(235 225 205 / 0.85) 0 8px, transparent 8px 18px);
    border-radius: 2px;
    opacity: 0.8;
  }
  .m-film::before {
    top: 5px;
  }
  .m-film::after {
    bottom: 5px;
  }
  .m-frames {
    display: flex;
    align-items: flex-end;
    gap: 6px;
  }
  .m-frame {
    position: relative;
    flex: none;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 2px solid #000;
    border-radius: 2px;
    background: #2a2620;
  }
  .m-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.25) saturate(0.9);
  }
  .m-frame.age-2 {
    width: 25%;
    opacity: 0.75;
  }
  .m-frame.age-1 {
    width: 29%;
    opacity: 0.9;
  }
  .m-frame.now {
    width: 34%;
    border-color: #f2483a;
  }
  .m-frame.now img {
    filter: none;
  }
  .m-code {
    position: absolute;
    left: 4px;
    bottom: 2px;
    color: #ffb547;
    font: 600 10px/1 var(--font-mono);
    letter-spacing: 0.04em;
    text-shadow: 0 1px 2px #000;
  }
  .m-frame.now .m-code {
    color: #fff;
  }
  .m-frame.now .m-code::before {
    content: '● ';
    color: #f2483a;
  }
  .m-arrow {
    align-self: center;
    color: rgb(235 225 205 / 0.45);
    font-size: 13px;
  }
  .m-caption {
    display: none;
    flex: 1;
    min-width: 0;
    margin: 0;
    color: #d9cfbd;
    font-size: 13px;
    line-height: 1.45;
  }
  .m-caption b {
    display: block;
    color: #ffb547;
    font: 600 12px/1.6 var(--font-mono);
  }

  .m-top {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .m-thumb {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 6px;
    background: #000;
  }
  .m-info {
    flex: 1;
    min-width: 0;
  }
  .m-heading {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
  }
  .m-time {
    margin: 2px 0 8px;
    color: #b3b3b3;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .m-field {
    min-height: 3.6em;
    padding: 8px 10px;
    border: 1px solid #555;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.08);
  }
  .m-note {
    min-height: 5em;
    margin-top: 12px;
    border-color: transparent;
    outline: 2px solid #e5a00d;
  }
  .m-caret {
    display: inline-block;
    width: 2px;
    height: 1.15em;
    margin-left: 2px;
    vertical-align: -0.2em;
    background: #ffb547;
  }
  @media (prefers-reduced-motion: no-preference) {
    .m-caret {
      animation: blink 1.1s steps(1) infinite;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .m-hint {
    margin: 6px 0 0;
    color: #b3b3b3;
    font-size: 12px;
  }
  .m-footer {
    display: flex;
    justify-content: flex-end;
    margin: 8px 0 0;
  }
  .m-footer span {
    color: #8ab4f8;
    text-decoration: underline;
  }

  /* Wide enough: the overlay's own side-by-side layout. */
  @container (min-width: 520px) {
    .m-frames {
      gap: 8px;
    }
    .m-frames {
      flex: none;
    }
    .m-frame.age-2 {
      width: auto;
      height: 52px;
    }
    .m-frame.age-1 {
      width: auto;
      height: 64px;
    }
    .m-frame.now {
      width: auto;
      height: 78px;
    }
    .m-film {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .m-caption {
      display: block;
    }
    .m-top {
      flex-direction: row;
      align-items: flex-start;
      gap: 16px;
    }
    .m-thumb {
      flex: 0 0 42%;
      width: 42%;
    }
  }
</style>
