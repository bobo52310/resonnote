{
  "name": "resonnote",
  "description": "Chrome extension that saves a screenshot, timestamp, subtitle and your own note at the moment a scene resonates, on Netflix, YouTube and Disney+",
  "private": true,
  "license": "MIT",
  "author": "Bobo Chen (https://github.com/bobo52310)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobo52310/resonnote.git"
  },
  "homepage": "https://resonnote.pages.dev",
  "bugs": {
    "url": "https://github.com/bobo52310/resonnote/issues"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "packageManager": "pnpm@12.10.1",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb": "^8.0.4"
  }
}
